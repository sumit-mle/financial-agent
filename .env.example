# =============================================================================
# Fin AI Agent — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- App ---
APP_ENV=development                        # development | staging | production
APP_NAME=fin-ai-agent
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# --- LLM Providers (fill at least one) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Primary LLM provider: openai | anthropic | local
LLM_PROVIDER=openai

# --- Reranker ---
COHERE_API_KEY=...                         # Optional: uses FlashRank local if not set
RERANKER_PROVIDER=flashrank               # flashrank | cohere
RERANKER_TOP_K=5

# --- Vector Store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                            # Leave empty for local dev
QDRANT_COLLECTION_COMPLAINTS=complaints
QDRANT_COLLECTION_POLICIES=policies
QDRANT_COLLECTION_FAQ=faq

# --- PostgreSQL (Metadata + Conversation History) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fin_ai_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fin_ai_agent

# --- Redis (Session Cache + Rate Limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or http://localhost:3000 for self-hosted

# --- Data Sources ---
# CFPB Complaint Database (auto-downloaded, no key needed)
CFPB_DATA_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip

# SEC EDGAR (no key needed for public filings)
SEC_EDGAR_BASE_URL=https://data.sec.gov

# --- Ingestion Config ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_BATCH_SIZE=32
INGEST_WORKERS=4

# --- Agent Config ---
AGENT_MAX_ITERATIONS=10
AGENT_CONFIDENCE_THRESHOLD=0.75           # Below this → escalate to human
AGENT_ESCALATION_THRESHOLD=0.50           # Below this → always escalate
RETRIEVAL_TOP_K=10
CONTEXT_MAX_TOKENS=8000

# --- Action Execution (mocked in dev, replace with real endpoints) ---
CRM_API_URL=http://localhost:9001/mock/crm
TICKETING_API_URL=http://localhost:9001/mock/tickets
NOTIFICATION_API_URL=http://localhost:9001/mock/notify

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# ── Salesforce CRM Integration ──────────────────────────────────────────────────
# Create a Connected App in Salesforce Setup > Apps > Connected Apps
# Enable OAuth Settings and add these scopes: api, refresh_token, offline_access
SALESFORCE_USERNAME="your-salesforce-username@company.com"
SALESFORCE_PASSWORD="your-password-plus-security-token"
SALESFORCE_CLIENT_ID="your-connected-app-consumer-key"
SALESFORCE_CLIENT_SECRET="your-connected-app-consumer-secret"
SALESFORCE_DOMAIN="login"  # or "test" for sandbox, or custom domain